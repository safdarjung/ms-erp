# --- Database (Postgres via docker-compose, host port 5433) ---
# App connects as a NON-superuser role with RLS enforced:
DATABASE_URL=postgresql://app_user:app_pw@localhost:5433/mserp
# Admin/superuser connection for migrations, DDL and role setup:
DATABASE_URL_ADMIN=postgresql://postgres:postgres@localhost:5433/mserp

# --- Hosted alternative: Supabase (free tier) — see DEPLOY.md ---
# App/runtime → transaction pooler (port 6543; the client already uses prepare:false):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Migrations/setup → direct connection (port 5432):
# DATABASE_URL_ADMIN=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Auth ---
# 32+ random bytes in production. Rotate to invalidate all sessions.
SESSION_SECRET=change-me-to-a-long-random-secret

# --- Redis (jobs/queues/cache) ---
REDIS_URL=redis://localhost:6379

# --- MinIO / S3 (drawings, generated PDFs) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ms-erp

# --- App ---
APP_URL=http://localhost:3000

# --- AI ---
# Powers the ⌘K assistant (ask-your-data), quotation drafting and terms polish.
# Provide EITHER key; both blank = AI off (every non-AI feature works normally).
# Claude (the blueprint's provider) — console.anthropic.com → API keys:
ANTHROPIC_API_KEY=
# Google Gemini (AI Studio free tier) — aistudio.google.com → Get API key:
GEMINI_API_KEY=
# If both keys are set, Claude wins; force one with AI_PROVIDER=claude|gemini
# AI_PROVIDER=

# --- Inbound lead capture (email → Lead inbox) ---
# Shared secret the mail-forwarding provider (Cloudflare Email Worker / Postmark
# inbound) must send as the `x-webhook-secret` header (or `?key=`) when POSTing to
# /api/leads/inbound. Blank = the endpoint rejects everything. Generate: openssl rand -hex 24
INBOUND_WEBHOOK_SECRET=
# The domain of your capture address (leads+<token>@<domain>) shown in Settings →
# Lead sources. Cosmetic hint only; set it to whatever inbound domain you configure.
INBOUND_EMAIL_DOMAIN=inbound.your-domain.com
